@model LoginViewModel
@{ ViewData["Title"] = "Admin Login"; }

@section Styles {
<style>
.auth-wrap { min-height:100vh; display:grid; place-items:center; padding:24px 16px; }
.auth-card { width:min(480px,100%); padding:56px 48px; border-radius:28px; background:var(--glass-bg-strong); backdrop-filter:blur(24px) saturate(160%); -webkit-backdrop-filter:blur(24px) saturate(160%); border:1px solid var(--glass-border); box-shadow:0 12px 56px rgba(138,109,63,.15); }
.auth-card__logo { text-align:center; margin-bottom:32px; }
.auth-card__logo img { height:52px; object-fit:contain; }
.mark-lg { width:52px; height:52px; border-radius:50%; background:linear-gradient(135deg,var(--gold),var(--gold-deep)); color:#fff; font-family:'Cormorant Garamond',serif; font-weight:700; font-size:1.6rem; display:grid; place-items:center; margin:0 auto 12px; }
.auth-card h2 { font-size:2rem; text-align:center; margin-bottom:8px; }
.auth-card .sub { text-align:center; color:var(--ink-soft); font-size:.9rem; margin-bottom:32px; }
.form-group { margin-bottom:26px; }
.form-group label { display:block; font-size:.85rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:10px; }
.form-group input { width:100%; padding:20px 22px; border-radius:14px; border:1.5px solid var(--line); background:rgba(255,252,245,.7); font-family:'DM Sans',sans-serif; font-size:1.05rem; color:var(--ink); outline:none; transition:border-color .25s,box-shadow .25s; }
.form-group input:focus { border-color:var(--gold); box-shadow:0 0 0 4px rgba(184,153,104,.18); }
.form-group input::placeholder { color:#c0b5a8; }
.btn-submit { width:100%; padding:20px; border:none; border-radius:999px; font-family:'DM Sans',sans-serif; font-size:1.1rem; font-weight:600; color:#fff; background:linear-gradient(135deg,var(--gold),var(--gold-deep)); cursor:pointer; box-shadow:0 8px 24px rgba(138,109,63,.35); transition:transform .25s,box-shadow .25s; margin-top:14px; letter-spacing:.04em; }
.btn-submit:hover { transform:translateY(-2px); box-shadow:0 12px 32px rgba(138,109,63,.45); }
.validation-summary-errors { background:rgba(220,53,69,.08); border:1px solid rgba(220,53,69,.25); border-radius:12px; padding:14px 18px; margin-bottom:20px; font-size:.88rem; color:#c0392b; }
.field-validation-error { font-size:.82rem; color:#c0392b; margin-top:6px; display:block; }
</style>
}

<div class="auth-wrap">
    <div class="auth-card">

        <form asp-action="Login" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="All" class="validation-summary-errors"
                 style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>
            <div class="form-group">
                <label asp-for="Username"></label>
                <input asp-for="Username" placeholder="Enter username" autocomplete="username" />
                <span asp-validation-for="Username" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" placeholder="Enter password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <button type="submit" class="btn-submit">Sign In →</button>
        </form>
    </div>
</div>