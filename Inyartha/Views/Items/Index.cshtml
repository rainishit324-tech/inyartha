@model List<ItemTemplate>
@{
    ViewData["Title"] = "Manage Items";
}

<div class="dashboard">
    <div style="display:flex;gap:0;border-bottom:2px solid var(--line);margin-bottom:28px;">
        <a href="/Quote" style="padding:12px 28px;font-size:0.9rem;font-weight:500;color:var(--ink-soft);border-bottom:2px solid transparent;margin-bottom:-2px;transition:color .2s;text-decoration:none;">Quotes Dashboard</a>
        <a href="/Items" style="padding:12px 28px;font-size:0.9rem;font-weight:600;color:var(--gold-deep);border-bottom:2px solid var(--gold-deep);margin-bottom:-2px;transition:color .2s;">Manage Items</a>
    </div>
    <div class="dashboard__header">
        <div>
            <div class="section__tag" style="margin-bottom:12px;">Admin Panel</div>
            <h1>Manage Items</h1>
        </div>
        <a href="/Items/Create" class="btn btn--gold btn--lg">+ New Item</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="quotes-table-wrap">
            <div class="empty-state">
                <h3>No items yet</h3>
                <p>Add your first line item to get started.</p>
                <a href="/Items/Create" class="btn btn--gold">Create First Item</a>
            </div>
        </div>
    }
    else
    {
        <div class="quotes-table-wrap">
            <div style="display:flex;gap:12px;align-items:center;margin-bottom:16px;flex-wrap:wrap;padding:18px 18px 0;">
                <div style="flex:1;min-width:200px;position:relative;">
                    <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--ink-soft);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    <input id="search-input" type="text" placeholder="Search by name, material..." style="width:100%;padding:10px 12px 10px 38px;border:1px solid var(--line);border-radius:var(--radius-lg);font-size:0.9rem;outline:none;background:var(--white);" oninput="filterTable()" />
                </div>
                <div style="display:flex;align-items:center;gap:8px;font-size:0.85rem;color:var(--ink-soft);">
                    <span>Show</span>
                    <select id="page-size-select" style="padding:6px 10px;border:1px solid var(--line);border-radius:6px;font-size:0.85rem;outline:none;" onchange="filterTable()">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="0">All</option>
                    </select>
                    <span>per page</span>
                </div>
            </div>
            <div style="overflow-x:auto;">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Material</th>
                            <th>Price (Rate)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="table-body">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong style="color:var(--ink);">@item.Name</strong></td>
                                <td>@(string.IsNullOrEmpty(item.Material) ? "\u2014" : item.Material)</td>
                                <td style="font-family:var(--font-serif);font-weight:600;color:var(--gold-deep);">&#x20B9; @item.Rate.ToString("N2")</td>
                                <td>
                                    <div class="actions">
                                        <a href="/Items/Edit?name=@Uri.EscapeDataString(item.Name)&material=@Uri.EscapeDataString(item.Material)" class="btn-sm btn-edit">Edit</a>
                                        <form action="/Items/Copy" method="post" style="display:inline;margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="name" value="@item.Name" />
                                            <input type="hidden" name="material" value="@item.Material" />
                                            <button type="submit" class="btn-sm" style="background:rgba(0,0,0,.04);color:var(--ink);">Copy</button>
                                        </form>
                                        <form action="/Items/Delete" method="post" style="display:inline;margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="name" value="@item.Name" />
                                            <input type="hidden" name="material" value="@item.Material" />
                                            <button type="submit" class="btn-sm btn-delete" onclick="return confirm('Delete item &quot;@item.Name&quot;?')">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="pagination-controls" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;padding:16px 18px 18px;">
                <div id="pagination-info" style="font-size:0.85rem;color:var(--ink-soft);"></div>
                <div id="pagination-buttons" style="display:flex;gap:6px;align-items:center;"></div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterTable() {
            var input = document.getElementById('search-input');
            var filter = input ? input.value.toLowerCase() : '';
            var rows = document.querySelectorAll('#table-body tr');
            var matched = [];

            rows.forEach(function(row) {
                var text = row.textContent.toLowerCase();
                if (text.indexOf(filter) !== -1) {
                    row.style.display = '';
                    matched.push(row);
                } else {
                    row.style.display = 'none';
                }
            });

            var pageSizeSelect = document.getElementById('page-size-select');
            var pageSize = parseInt(pageSizeSelect ? pageSizeSelect.value : '10', 10);

            var totalMatched = matched.length;
            var totalPages = pageSize > 0 ? Math.ceil(totalMatched / pageSize) : 1;
            if (totalPages < 1) totalPages = 1;

            var currentPage = 1;
            var btnContainer = document.getElementById('pagination-buttons');
            var infoEl = document.getElementById('pagination-info');
            if (!btnContainer || !infoEl) return;

            function showPage(page) {
                currentPage = page;
                var start = pageSize > 0 ? (page - 1) * pageSize : 0;
                var end = pageSize > 0 ? start + pageSize : totalMatched;

                matched.forEach(function(row, idx) {
                    if (idx >= start && idx < end) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });

                var from = totalMatched === 0 ? 0 : start + 1;
                var to = Math.min(end, totalMatched);
                infoEl.textContent = 'Showing ' + from + '\u2013' + to + ' of ' + totalMatched + ' item' + (totalMatched !== 1 ? 's' : '');

                renderButtons();
            }

            function renderButtons() {
                btnContainer.innerHTML = '';
                if (totalPages <= 1 && pageSize > 0) {
                    var from = totalMatched === 0 ? 0 : 1;
                    var to = Math.min(pageSize, totalMatched);
                    infoEl.textContent = 'Showing ' + from + '\u2013' + to + ' of ' + totalMatched + ' item' + (totalMatched !== 1 ? 's' : '');
                    return;
                }

                var prev = document.createElement('button');
                prev.textContent = '\u2039 Prev';
                prev.style.cssText = 'padding:6px 14px;border:1px solid var(--line);border-radius:6px;background:var(--white);cursor:pointer;font-size:0.85rem;color:var(--ink);';
                prev.disabled = currentPage === 1;
                if (prev.disabled) { prev.style.opacity = '0.4'; prev.style.cursor = 'default'; }
                prev.addEventListener('click', function() { if (currentPage > 1) showPage(currentPage - 1); });
                btnContainer.appendChild(prev);

                var maxVisible = 5;
                var startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
                var endPage = Math.min(totalPages, startPage + maxVisible - 1);
                if (endPage - startPage < maxVisible - 1) startPage = Math.max(1, endPage - maxVisible + 1);

                if (startPage > 1) {
                    var first = document.createElement('button');
                    first.textContent = '1';
                    first.style.cssText = 'padding:6px 12px;border:1px solid var(--line);border-radius:6px;background:var(--white);cursor:pointer;font-size:0.85rem;color:var(--ink);';
                    first.addEventListener('click', function() { showPage(1); });
                    btnContainer.appendChild(first);
                    if (startPage > 2) {
                        var dots = document.createElement('span');
                        dots.textContent = '\u2026';
                        dots.style.cssText = 'padding:6px 4px;font-size:0.85rem;color:var(--ink-soft);';
                        btnContainer.appendChild(dots);
                    }
                }

                for (var i = startPage; i <= endPage; i++) {
                    var btn = document.createElement('button');
                    btn.textContent = i;
                    var isActive = i === currentPage;
                    btn.style.cssText = 'padding:6px 12px;border:1px solid ' + (isActive ? 'var(--gold-deep)' : 'var(--line)') + ';border-radius:6px;background:' + (isActive ? 'var(--gold-deep)' : 'var(--white)') + ';cursor:pointer;font-size:0.85rem;color:' + (isActive ? '#fff' : 'var(--ink)') + ';';
                    btn.addEventListener('click', function(p) { return function() { showPage(p); }; }(i));
                    btnContainer.appendChild(btn);
                }

                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        var dots2 = document.createElement('span');
                        dots2.textContent = '\u2026';
                        dots2.style.cssText = 'padding:6px 4px;font-size:0.85rem;color:var(--ink-soft);';
                        btnContainer.appendChild(dots2);
                    }
                    var last = document.createElement('button');
                    last.textContent = totalPages;
                    last.style.cssText = 'padding:6px 12px;border:1px solid var(--line);border-radius:6px;background:var(--white);cursor:pointer;font-size:0.85rem;color:var(--ink);';
                    last.addEventListener('click', function() { showPage(totalPages); });
                    btnContainer.appendChild(last);
                }

                var next = document.createElement('button');
                next.textContent = 'Next \u203a';
                next.style.cssText = 'padding:6px 14px;border:1px solid var(--line);border-radius:6px;background:var(--white);cursor:pointer;font-size:0.85rem;color:var(--ink);';
                next.disabled = currentPage === totalPages;
                if (next.disabled) { next.style.opacity = '0.4'; next.style.cursor = 'default'; }
                next.addEventListener('click', function() { if (currentPage < totalPages) showPage(currentPage + 1); });
                btnContainer.appendChild(next);
            }

            showPage(1);
        }

        document.addEventListener('DOMContentLoaded', filterTable);
    </script>
}
